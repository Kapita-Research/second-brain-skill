properties:
  job_title:
    displayName: Title
  department:
    displayName: Department
  company:
    displayName: Company
  email:
    displayName: Email
  phone:
    displayName: Phone
  contact:
    displayName: Standing
  last-contact:
    displayName: Last contact
  members:
    displayName: Members
views:
  - type: table
    name: Directory
    filters:
      and:
        - not:
            - file.inFolder("Templates")
        - type == "person"
        - not:
            - 'contact == "none"'
    order:
      - file.name
      - job_title
      - department
      - company
      - email
      - phone
      - last-contact
  - type: table
    name: By department
    filters:
      and:
        - not:
            - file.inFolder("Templates")
        - type == "person"
        - not:
            - 'contact == "none"'
    groupBy:
      property: department
      direction: ASC
    order:
      - file.name
      - job_title
      - last-contact
  - type: table
    name: Reference (never contacts)
    filters:
      and:
        - not:
            - file.inFolder("Templates")
        - type == "person"
        - 'contact == "none"'
    order:
      - file.name
      - job_title
      - file.mtime
  - type: table
    name: Dormant
    filters:
      and:
        - not:
            - file.inFolder("Templates")
        - type == "person"
        - 'contact == "dormant"'
    order:
      - file.name
      - job_title
      - company
      - last-contact
  - type: table
    name: Groups
    filters:
      and:
        - not:
            - file.inFolder("Templates")
        - type == "group"
    order:
      - file.name
      - members
      - file.mtime
