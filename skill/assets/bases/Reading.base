properties:
  author:
    displayName: Author
  status:
    displayName: Status
  rating:
    displayName: Rating
  created:
    displayName: Added
views:
  - type: table
    name: "Reading now"
    filters:
      and:
        - not:
            - file.inFolder("Templates")
        - or:
            - 'type == "book"'
            - 'type == "source"'
        - 'status == "reading"'
    order:
      - file.name
      - author
      - status
  - type: table
    name: "To read"
    filters:
      and:
        - not:
            - file.inFolder("Templates")
        - or:
            - 'type == "book"'
            - 'type == "source"'
        - 'status == "to-read"'
    order:
      - file.name
      - author
      - created
  - type: table
    name: "Finished"
    filters:
      and:
        - not:
            - file.inFolder("Templates")
        - 'status == "done"'
        - or:
            - 'type == "book"'
            - 'type == "source"'
    order:
      - file.name
      - author
      - rating
